        },
        {
          "name": "Maand",
          "dataType": "string"
        },
        {
          "name": "Maandnummer",
          "dataType": "Int64"
        },
        {
          "name": "Week",
          "dataType": "string"
        },
        {
          "name": "Weekdag",
          "dataType": "string",
          "sortByColumn": "Weekdagnummer"
        },
        {
          "name": "Weekdagnummer",
          "dataType": "Int64"
        }
      ]
    },
    {
      "name": "DimTerminal",
